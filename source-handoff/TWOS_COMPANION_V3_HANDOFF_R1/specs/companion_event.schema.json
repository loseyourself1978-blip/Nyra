{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed TWOS companion read-only event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "sequence",
    "timestamp",
    "origin",
    "kind",
    "execution_id",
    "channel_status",
    "business_status",
    "verification_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "twos",
        "simulator"
      ]
    },
    "kind": {
      "enum": [
        "task.received",
        "plan.started",
        "plan.ready",
        "run.queued",
        "run.started",
        "run.progress",
        "approval.required",
        "verification.started",
        "execution.completed",
        "business.partial",
        "business.failed",
        "verification.passed",
        "owner.accepted",
        "run.cancelled",
        "connection.lost",
        "connection.restored"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "opaque identifier only; no task title or body"
    },
    "channel_status": {
      "enum": [
        "idle",
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "business_status": {
      "enum": [
        "none",
        "pending",
        "unverified",
        "partial",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "verification_status": {
      "enum": [
        "not_run",
        "pass",
        "fail",
        "unknown"
      ]
    },
    "owner_acceptance": {
      "enum": [
        "not_requested",
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "progress_fraction": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    }
  }
}
